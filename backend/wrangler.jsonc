{
  "name": "jarvis-hub-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HUBS", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": false }
}
