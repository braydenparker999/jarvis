# FICTIONAL_NATIVE_EVENT_COST_QUERIES {"name":"legacyIndexCold","queries":[{"query":"CREATE INDEX IF NOT EXISTS relay_event_kind_seq ON relay_events((CASE WHEN json_extract(data,'$.inbox_id')='brayden-owner' THEN 'relay.owner.message.created'\\n  WHEN COALESCE(json_extract(data,'$.coordination_event_id'),'') NOT IN ('',0) THEN 'relay.public.result.changed' ELSE 'relay.message.created' END),seq)","rowsRead":12111,"rowsWritten":6001},{"query":"SELECT seq FROM relay_events INDEXED BY relay_event_kind_seq\\n      WHERE (CASE WHEN json_extract(data,'$.inbox_id')='brayden-owner' THEN 'relay.owner.message.created'\\n  WHEN COALESCE(json_extract(data,'$.coordination_event_id'),'') NOT IN ('',0) THEN 'relay.public.result.changed' ELSE 'relay.message.created' END)=? AND seq>? AND seq<=? ORDER BY seq LIMIT ?","rowsRead":250,"rowsWritten":0},{"query":"SELECT e.*,COALESCE(b.body,u.body) AS message_body FROM relay_events e INDEXED BY relay_event_kind_seq\\n      LEFT JOIN shared_entries u ON u.id=e.message_id AND u.kind='user'\\n      LEFT JOIN relay_owner_event_bodies b ON b.event_id=e.event_id\\n      LEFT JOIN relay_outbox o ON o.subscription_id=? AND o.event_seq=e.seq\\n      WHERE (CASE WHEN json_extract(data,'$.inbox_id')='brayden-owner' THEN 'relay.owner.message.created'\\n  WHEN COALESCE(json_extract(data,'$.coordination_event_id'),'') NOT IN ('',0) THEN 'relay.public.result.changed' ELSE 'relay.message.created' END)=? AND e.seq>? AND e.seq<=? AND o.event_seq IS NULL AND COALESCE(b.body,u.body) IS NOT NULL AND (instr(lower(COALESCE(b.body,u.body)),?)>0 OR COALESCE(b.body,u.body) GLOB '*[^ -~]*' OR instr(COALESCE(b.body,u.body),char(0))>0)\\n      ORDER BY e.seq LIMIT 250","rowsRead":501,"rowsWritten":0}]}
